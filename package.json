{
  "name": "renovate-defaults",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "validate:renovate:config": "renovate-config-validator --strict --no-global default.jsonc && renovate-config-validator --strict --no-global .github/renovate.jsonc",
    "test:renovate:config": "renovate --platform=local --dry-run=lookup --config-validation-error"
  },
  "devDependencies": {
    "renovate": "44.50.3"
  }
}
