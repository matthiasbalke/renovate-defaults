{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    // use conventional commits
    ":semanticCommits",
    // always update kotlin Gradle plugins at the same time, in one PR branch
    "group:kotlinMonorepo",
    // support for _VERSION variables in GitHub Actions workflow/action YAML files
    "customManagers:githubActionsVersions"
  ],

  "customDatasources": {
    "alpine_3_23": {
      "defaultRegistryUrlTemplate": "https://dl-cdn.alpinelinux.org/alpine/v3.23/main/x86_64/",
      "format": "html"
    },
    "alpine_3_24": {
      "defaultRegistryUrlTemplate": "https://dl-cdn.alpinelinux.org/alpine/v3.24/main/x86_64/",
      "format": "html"
    },
    "dhi_alpine_3_23": {
      "defaultRegistryUrlTemplate": "https://dhi.io/apk/alpine/v3.23/main/index.html",
      "format": "plain",
      "transformTemplates": [
        "( $html := $join(releases.version, \"\\n\"); $matches := $match($html, /\"n\":\"{{{packageName}}}\",\"v\":\"([^\"]+)\",\"a\":\"[^\"]+\",\"ch\":\"v3\\.23\",\"co\":\"main\"/); $versions := $distinct($map($matches, function($match) { $match.groups[0] })); { \"releases\": [ $map($versions, function($version) { { \"version\": $version } }) ] } )"
      ]
    },
    "dhi_alpine_3_24": {
      "defaultRegistryUrlTemplate": "https://dhi.io/apk/alpine/v3.24/main/index.html",
      "format": "plain",
      "transformTemplates": [
        "( $html := $join(releases.version, \"\\n\"); $matches := $match($html, /\"n\":\"{{{packageName}}}\",\"v\":\"([^\"]+)\",\"a\":\"[^\"]+\",\"ch\":\"v3\\.24\",\"co\":\"main\"/); $versions := $distinct($map($matches, function($match) { $match.groups[0] })); { \"releases\": [ $map($versions, function($version) { { \"version\": $version } }) ] } )"
      ]
    }
  },

  "customManagers": [
    {
      "customType": "regex",
      "description": "Update annotated _VERSION ENV and ARG variables with alpine apk package versions in Dockerfiles",
      "managerFilePatterns": [
        "/(^|/|\\.)Dockerfile$/",
        "/(^|/)Dockerfile\\.[^/]*$/"
      ],
      "matchStrings": [
        "# renovate: alpine:\\s+datasource=(?<datasource>[^\\s]+)\\s+packageName=(?<packageName>[^\\s]+)\\s+(?:ENV|ARG)\\s+[^\\s=]+_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "versioningTemplate": "loose",
      "extractVersionTemplate": "^{{{packageName}}}-(?<version>.+)\\.apk$"
    },
    {
      "customType": "regex",
      "description": "Update annotated _VERSION ENV and ARG variables with DHI Alpine apk package versions in Dockerfiles",
      "managerFilePatterns": [
        "/(^|/|\\.)Dockerfile$/",
        "/(^|/)Dockerfile\\.[^/]*$/"
      ],
      "matchStrings": [
        "# renovate: dhi_alpine:\\s+datasource=(?<datasource>[^\\s]+)\\s+packageName=(?<packageName>[^\\s]+)\\s+(?:ENV|ARG)\\s+[^\\s=]+_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Update renovate shared presets based on GitHub releases",
      "managerFilePatterns": [
        "/^renovate\\.jsonc?$/",
        "/^\\.github/renovate\\.jsonc?$/"
      ],
      "matchStrings": [
        "\"github>matthiasbalke/renovate-defaults:.*#(?<currentValue>[^\" \\n\\(]+)",
        "\"github>matthiasbalke/renovate-defaults/.*#(?<currentValue>[^\" \\n\\(]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "matthiasbalke/renovate-defaults",
      "depTypeTemplate": "renovate-preset"
    }
  ],

  // https://github.com/homeassistant-apps/app-cloudflared/blob/main/.github/renovate.json
  // rebasing is required to merge PRs into main
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboard": true,
  // label dependency updates nicely
  "labels": ["dependencies", "no-stale"],

  // https://github.com/renovatebot/renovate/discussions/40077#discussioncomment-15300800
  "registryAliases": {
    "dhi.io": "dhi.io"
  },

  "packageRules": [
    {
      "matchDepTypes": [
        "renovate-preset"
      ],
      "prPriority": 99
    }
  ]
}
